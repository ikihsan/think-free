#!/usr/bin/env python3
"""stg - stage part of a file by line number, without a terminal.

Thin wrapper so the tool also runs straight from a source checkout:
    ./stg list
When the package is installed, the same command is on PATH as `stg`.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from stg_cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

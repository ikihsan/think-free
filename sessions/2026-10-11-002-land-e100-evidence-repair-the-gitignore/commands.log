import sys, time
sys.path.insert(0, 'tools')
from originlib.doclint import lint
from pathlib import Path
start = time.time()
result = lint(Path('.'))
elapsed = time.time() - start
print(f'lint completed in {elapsed:.1f}s')
print(f'files checked: {result.checked}')
print(f'violations: {len(result.violations)}')
for v in result.violations[:30]:
    print(f'  {v}')
print(f'infos: {len(result.infos)}')
for i in result.infos[:10]:
    print(f'  {i}')


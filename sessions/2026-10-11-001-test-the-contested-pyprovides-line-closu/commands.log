import json, math
lab=json.load(open('EXPERIMENTS/091-import-error-population/reread.json'))
rows=[json.loads(l) for l in open('EXPERIMENTS/091-import-error-population/classified.jsonl')]
n=len(rows); assert n==lab['gate']['denominator']==858, n
def wilson(k,n,z=1.96):
    if n==0: return (0,0)
    p=k/n; d=1+z*z/n; c=p+z*z/(2*n); m=z*math.sqrt(p*(1-p)/n+z*z/(4*n*n)); return ((c-m)/d,(c+m)/d)
from collections import Counter
c=Counter(l['verdict'] for l in lab['labels'])
print('labels:',dict(c),'distinct urls:',len(lab['labels']))
for k,name in [(sum(1 for l in lab['labels'] if l['verdict']=='genuine'),'strict'),(sum(1 for l in lab['labels'] if l['verdict'] in ('genuine','borderline')),'inclusive')]:
    lo,hi=wilson(k,n); print(f'{name}: {k}/{n} = {k/n:.4f}, Wilson CI95 [{lo:.4f}, {hi:.4f}], gate 0.01 ->', 'PASS (keep open)' if k/n>=0.01 else 'FAIL (close)')


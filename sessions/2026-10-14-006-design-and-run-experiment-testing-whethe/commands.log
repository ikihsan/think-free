import urllib.request, json
# Fetch a final rule full text using the same approach as E142
url = 'https://www.federalregister.gov/api/v1/documents.json?conditions%5Bterm%5D=final+rule&per_page=3&fields%5B%5D=document_number&fields%5B%5Draw_text_url&order=newest'
data = json.loads(urllib.request.urlopen(url, timeout=15).read())
for r in data.get('results', []):
    raw_url = r.get('raw_text_url')
    if raw_url:
        print(f'Raw URL: {raw_url}')
        try:
            text = urllib.request.urlopen(raw_url, timeout=20).read().decode('utf-8', 'replace')
            print(f'=== {r["document_number"]} ===')
            print(text[:5000])
            print('...')
            print()
        except Exception as e:
            print(f'Error: {e}')


import urllib.request, json
# Fetch a proposed rule full text
url = 'https://www.federalregister.gov/api/v1/documents.json?conditions%5Bterm%5D=proposed+rule&per_page=3&fields%5B%5D=document_number&fields%5B%5Draw_text_url&order=newest'
data = json.loads(urllib.request.urlopen(url, timeout=15).read())
for r in data.get('results', []):
    raw_url = r.get('raw_text_url')
    if raw_url:
        text = urllib.request.urlopen(raw_url, timeout=20).read().decode('utf-8', 'replace')
        print(f'=== {r["document_number"]} ===')
        # Show first 5000 chars
        print(text[:5000])
        print('...')
        print()


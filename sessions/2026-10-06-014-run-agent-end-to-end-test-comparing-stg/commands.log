import sys
sys.path.insert(0, 'EXPERIMENTS/041-strongest-baseline')
from shell_baseline import ShellBaseline
import subprocess
import tempfile
import os

# Test shell_baseline
d = tempfile.mkdtemp(prefix='test_sb_')
subprocess.run(['git', 'init', '-q', '.'], cwd=d, capture_output=True)
subprocess.run(['git', 'config', 'user.email', 't@e.st'], cwd=d, capture_output=True)
subprocess.run(['git', 'config', 'user.name', 'T'], cwd=d, capture_output=True)
with open(os.path.join(d, 'f.txt'), 'w') as fh:
    fh.write('line1\nline2\nline3\nline4\nline5\n')
subprocess.run(['git', 'add', 'f.txt'], cwd=d, capture_output=True)
subprocess.run(['git', 'commit', '-qm', 'init'], cwd=d, capture_output=True)
with open(os.path.join(d, 'f.txt'), 'w') as fh:
    fh.write('line1\nMODIFIED2\nline3\nline4\nline5\n')

baseline = ShellBaseline()
rc, out, err, staged = baseline.stage(d, 'f.txt', 2)
print(f'rc={rc}, out={out!r}, err={err!r}, staged={staged!r}')

# Check index
result = subprocess.run(['git', 'show', ':f.txt'], cwd=d, capture_output=True)
print(f'index: {result.stdout.decode()!r}')
import shutil
shutil.rmtree(d)


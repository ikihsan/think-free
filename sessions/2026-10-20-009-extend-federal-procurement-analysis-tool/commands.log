import requests
import json

# Check USAspending API documentation for available fields
# First, let's see what fields are available for spending_by_award
url = 'https://api.usaspending.gov/api/v2/search/spending_by_award/'
payload = {
    'fields': ['Award ID', 'Award Amount', 'Description', 'Recipient Name', 'generated_internal_id', 'PSC Code', 'NAICS Code', 'Contract IDV PIID'],
    'filters': {'award_type_codes': ['A', 'B', 'C', 'D'], 'psc_codes': ['7030']},
    'page': 1,
    'limit': 1
}
r = requests.post(url, json=payload, timeout=30)
print('Status:', r.status_code)
if r.status_code == 200:
    data = r.json()
    print('Fields in result:', list(data.get('results', [{}])[0].keys()) if data.get('results') else 'no results')
    # Also check page_metadata
    print('Page metadata:', data.get('page_metadata'))
else:
    print(r.text[:1000])


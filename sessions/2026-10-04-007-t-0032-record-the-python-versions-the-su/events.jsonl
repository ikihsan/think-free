{"actor": "opencode", "data": {"argv": ["sh", "-c", "\necho \"=== FALSIFICATION 1: floor claims a minor version nothing ran (3.10) ===\"\npython3 -c \"\nimport json\nd=json.load(open(\\\"tests/python-versions.json\\\"))\nd[\\\"floor\\\"][\\\"claim\\\"]=\\\"3.10 or newer\\\"\njson.dump(d,open(\\\"tests/python-versions.json\\\",\\\"w\\\"),indent=2)\n\"\nenv PYTHONPATH=tools:tests python3 -m unittest discover -s tests -t tests -p test_pythonversions.py 2>&1 | tail -3\ncp /tmp/opencode/pv-good.json tests/python-versions.json\necho \"=== FALSIFICATION 2: an entry with no scope ===\"\npython3 -c \"\nimport json\nd=json.load(open(\\\"tests/python-versions.json\\\"))\nd[\\\"verified\\\"][0].pop(\\\"scope\\\")\njson.dump(d,open(\\\"tests/python-versions.json\\\",\\\"w\\\"),indent=2)\n\"\nenv PYTHONPATH=tools:tests python3 -m unittest discover -s tests -t tests -p test_pythonversions.py 2>&1 | tail -3\ncp /tmp/opencode/pv-good.json tests/python-versions.json\necho \"=== FALSIFICATION 3: CI credited with an unreadable patch version ===\"\npython3 -c \"\nimport json\nd=json.load(open(\\\"tests/python-versions.json\\\"))\nd[\\\"verified\\\"][1][\\\"python\\\"]=\\\"3.12.7\\\"\njson.dump(d,open(\\\"tests/python-versions.json\\\",\\\"w\\\"),indent=2)\n\"\nenv PYTHONPATH=tools:tests python3 -m unittest discover -s tests -t tests -p test_pythonversions.py 2>&1 | tail -3\ncp /tmp/opencode/pv-good.json tests/python-versions.json\necho \"=== FALSIFICATION 4: unexercised list emptied ===\"\npython3 -c \"\nimport json\nd=json.load(open(\\\"tests/python-versions.json\\\"))\nd[\\\"not_exercised\\\"]=[]\njson.dump(d,open(\\\"tests/python-versions.json\\\",\\\"w\\\"),indent=2)\n\"\nenv PYTHONPATH=tools:tests python3 -m unittest discover -s tests -t tests -p test_pythonversions.py 2>&1 | tail -3\ncp /tmp/opencode/pv-good.json tests/python-versions.json\necho \"=== restored ===\"\nenv PYTHONPATH=tools:tests python3 -m unittest discover -s tests -t tests -p test_pythonversions.py 2>&1 | tail -3\
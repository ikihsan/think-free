import requests
# Try to find GSA SIN reference data
urls = [
    'https://www.gsa.gov/system/files/Schedule_70_SIN_Crosswalk.xlsx',
    'https://www.gsa.gov/system/files/GSASchedule70_SINs.csv',
    'https://www.gsa.gov/buying-selling/purchasing-programs/gsa-schedules/schedule-70-special-item-numbers',
]
for url in urls:
    try:
        r = requests.get(url, timeout=15, allow_redirects=True)
        print(f'{url} -> {r.status_code}, final: {r.url}')
        if r.status_code == 200:
            ct = r.headers.get('Content-Type', '')
            print(f'  Content-Type: {ct}')
            if 'csv' in ct or 'excel' in ct or 'spreadsheet' in ct:
                print(f'  Binary length: {len(r.content)}')
            else:
                print(f'  Text length: {len(r.text)}')
                print(f'  Sample: {r.text[:500]}')
    except Exception as e:
        print(f'{url} -> Error: {e}')


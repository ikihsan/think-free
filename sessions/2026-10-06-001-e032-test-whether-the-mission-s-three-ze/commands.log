import json
man=json.load(open("EXPERIMENTS/032-venue-recurrence/sheets/MANIFEST.json"))
rows=[json.loads(l) for l in open("EXPERIMENTS/032-venue-recurrence/raw/harvest.jsonl")]
def check(reader, labels):
    sheet="sheets/q1_%s.tsv"%reader
    keymap=man["keymap"]["q1_"+("reader1" if reader=="reader1" else "reader2")]
    lines=[l.rstrip("\n") for l in open("EXPERIMENTS/032-venue-recurrence/labels/"+labels) if l.strip()]
    d=lines[1:]
    ks=[l.split("\t")[0] for l in d]
    print("%s: %d data lines, %d distinct keys, %d in keymap, missing=%s, extra=%s"%(
        reader, len(d), len(set(ks)), sum(1 for k in ks if k in keymap),
        sorted(set(keymap)-set(ks))[:5], sorted(set(ks)-set(keymap))[:5]))
    order_ok = [keymap[k] for k in ks] == sorted(keymap[k] for k in ks) if reader=="reader1" else None
    if order_ok is not None: print("   reader1 keys follow input order:", order_ok)
    vals=[l.split("\t",1)[1].strip() for l in d]
    non=[v for v in vals if v!="none"]
    bad=[v for v in non if not (5<=len(v.split())<=30)]
    print("   none=%d  clauses=%d  bad_len=%d"%(len(vals)-len(non), len(non), len(bad)))
    return {k:v for k,v in zip(ks,vals)}
try:
    r1=check("reader1","q1_reader1.tsv")
except Exception as e:
    print("reader1 not readable:", e); r1=None
try:
    r2=check("reader2","q1_reader2.tsv")
except Exception as e:
    print("reader2 NOT READABLE YET:", type(e).__name__)
PY

    for line in open(p):
        line=line.strip()
        if not line: continue
        try: r=json.loads(line)
        except Exception: continue
        if isinstance(r,dict):
            for k in ("id","objectID","comment_id","question_id"):
                if r.get(k) is not None: s.add(str(r[k])); break
    return s

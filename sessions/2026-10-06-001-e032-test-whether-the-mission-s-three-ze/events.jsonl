{"actor": "unknown-agent", "data": {"argv": ["bash", "-c", "\npython3 - <<PY\nimport json\nman=json.load(open(\"EXPERIMENTS/032-venue-recurrence/sheets/MANIFEST.json\"))\nrows=[json.loads(l) for l in open(\"EXPERIMENTS/032-venue-recurrence/raw/harvest.jsonl\")]\ndef check(reader, labels):\n    sheet=\"sheets/q1_%s.tsv\"%reader\n    keymap=man[\"keymap\"][\"q1_\"+(\"reader1\" if reader==\"reader1\" else \"reader2\")]\n    lines=[l.rstrip(\"\\n\") for l in open(\"EXPERIMENTS/032-venue-recurrence/labels/\"+labels) if l.strip()]\n    d=lines[1:]\n    ks=[l.split(\"\\t\")[0] for l in d]\n    print(\"%s: %d data lines, %d distinct keys, %d in keymap, missing=%s, extra=%s\"%(\n        reader, len(d), len(set(ks)), sum(1 for k in ks if k in keymap),\n        sorted(set(keymap)-set(ks))[:5], sorted(set(ks)-set(keymap))[:5]))\n    order_ok = [keymap[k] for k in ks] == sorted(keymap[k] for k in ks) if reader==\"reader1\" else None\n    if order_ok is not None: print(\"   reader1 keys follow input order:\", order_ok)\n    vals=[l.split(\"\\t\",1)[1].strip() for l in d]\n    non=[v for v in vals if v!=\"none\"]\n    bad=[v for v in non if not (5<=len(v.split())<=30)]\n    print(\"   none=%d  clauses=%d  bad_len=%d\"%(len(vals)-len(non), len(non), len(bad)))\n    return {k:v for k,v in zip(ks,vals)}\ntry:\n    r1=check(\"reader1\",\"q1_reader1.tsv\")\nexcept Exception as e:\n    print(\"reader1 not readable:\", e); r1=None\ntry:\n    r2=check(\"reader2\",\"q1_reader2.tsv\")\nexcept Exception as e:\n    print(\"reader2 NOT READABLE YET:\", type(e).__name__)\nPY"], "cwd": "/home/ubuntu/think-free", "duration_ms": 190, "exit_code": 0, "log": "sessions/2026-10-06-001-e032-test-whether-the-mission-s-three-ze/commands.log", "log_line_end": 407, "log_line_start": 400, "redactions": [], "summary": "$ bash -c \npython3 - <<PY\nimport json\nman=json.load(open(\"EXPERIMENTS/032-venue-recurrence/sheets/MANIFEST.json\"))\nrows=[json.loads(l) for l i"}, "duration_ms": 190, "exit_code": 0, "hos
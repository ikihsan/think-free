import json, urllib.request, urllib.parse
terms = ['reproducible builds', 'build provenance', 'supply chain audit', 'lockfile drift', 'dependency quarantine', 'artifact provenance']
for t in terms:
    url = 'https://api.github.com/search/repositories?q=' + urllib.parse.quote(t) + '&sort=stars&order=desc&per_page=5'
    req = urllib.request.Request(url, headers={'User-Agent':'origin-research','Accept':'application/vnd.github+json'})
    try:
        d = json.load(urllib.request.urlopen(req, timeout=20))
        print('TERM', t, 'total', d.get('total_count'))
        for r in d.get('items', []):
            print('  ', r['full_name'], r['stargazers_count'], 'created', r['created_at'][:10], '|', (r['description'] or '')[:70])
    except Exception as e:
        print('TERM', t, 'ERR', e)


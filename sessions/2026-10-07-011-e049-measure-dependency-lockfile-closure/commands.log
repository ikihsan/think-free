for r in repos:
    u=f'https://api.github.com/repos/{r}/git/trees/HEAD?recursive=1'
    try:
        d=json.load(urllib.request.urlopen(u,timeout=15))
        paths=[t['path'] for t in d.get('tree',[]) if t['path'].rsplit('/',1)[-1] in ('poetry.lock','requirements.txt','package-lock.json','Cargo.lock','Pipfile.lock','pdm.lock','uv.lock','yarn.lock')]
        print(r, '->', paths[:4])
    except Exception as e: print(r,'ERR',getattr(e,'code',e))


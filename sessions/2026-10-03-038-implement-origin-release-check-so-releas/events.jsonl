{"actor": "opencode", "data": {"argv": ["bash", "-c", "cd /home/ubuntu/think-free\nPYTHONPATH=tools python3 - <<\"PY\"\nimport pathlib, shutil, tempfile\nfrom originlib import release\n\nbase = pathlib.Path(tempfile.mkdtemp(prefix=\"relcheck-\"))\n# A copy of this tree, with the pre-T-0022 manifest put back.\nfor name in (\"README.md\", \"AGENTS.md\", \"STATE.md\"):\n    shutil.copy2(name, base / name)\nshutil.copy2(\"/tmp/opencode/relfix/RELEASE-MANIFEST.md\", base / \"RELEASE-MANIFEST.md\")\n# git so docfiles can enumerate the tree; the fixture only needs the two files.\nsubprocess_run = __import__(\"subprocess\").run\nsubprocess_run([\"git\", \"init\", \"-q\"], cwd=str(base))\nsubprocess_run([\"git\", \"add\", \"-A\"], cwd=str(base))\nresult = release.check(base)\nprint(f\"pre-T-0022 manifest: {len(result.violations)} violation(s)\")\nfor problem in result.violations:\n    print(\"  \" + problem)\nprint(\"EXIT-WOULD-BE\", 0 if result.ok else 2)\nPY"], "cwd": "/home/ubuntu/think-free", "duration_ms": 215, "exit_code": 0, "log": "sessions/2026-10-03-038-implement-origin-release-check-so-releas/commands.log", "log_line_end": 8, "log_line_start": 1, "redactions": [], "summary": "$ bash -c cd /home/ubuntu/think-free\nPYTHONPATH=tools python3 - <<\"PY\"\nimport pathlib, shutil, tempfile\nfrom originlib import release\n\nbase = "}, "duration_ms": 215, "exit_code": 0, "host": "instance-20260717-0944", "kind": "command", "schema": "origin.session.event/1", "seq": 2, "session": "2026-10-03-038-implement-origin-release-check-so-releas", "ts": "2026-10-03T23:17:40+00:00"}
{"actor": "opencode", "data": {"argv": ["bash", "-c", "cd /home/ubuntu/think-free\ncp RELEASE-MANIFEST.md /tmp/opencode/relfix/new-manifest.md\ncp /tmp/opencode/relfix/RELEASE-MANIFEST.md RELEASE-MANIFEST.md\ntools/origin release check; echo \"exit with the pre-T-0022 manifest: $?\"\ncp /tmp/opencode/relfix/new-manifest.md RELEASE-MANIFEST.md\necho \"--- restored ---\"\ntools/origin release check; echo \"exit now: $?\"\ngit diff --stat RELEASE-MANIFEST.md"], "cwd": "/home/ubuntu/think-free", "duration_ms": 7094, "exit_code": 0, "log": "sessions/2026-10-03-038-implement-origin-release-check-so-releas/commands.log", "log_line_end": 63, "log_line_start": 56, "redactions": [], "summary": "$ bash -c cd /home/ubuntu/think-free\ncp RELEASE-MANIFEST.md /tmp/opencode/relfix/new-manifest.md\ncp /tmp/opencode/relfix/RELEASE-MANIFEST.md R"}, "duration_ms": 7094, "exit_code": 0, "host": "instance-20260717-0944", "kind": "command", "schema": "origin.session.event/1", "seq": 3, "session": "2026-10-03-038-implement-origin-release-check-so-releas", "ts": "2026-10-03T23:17:55+00:00"}

import urllib.request
import json

# Check Actual Budget loot-core for import-related tests
url = 'https://api.github.com/repos/actualbudget/actual/contents/packages/loot-core'
try:
    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
    resp = urllib.request.urlopen(req, timeout=10)
    print('Actual Budget loot-core:')
    for item in json.loads(resp.read()):
        print(f'  {item["name"]}: {item["type"]}')
except Exception as e:
    print(f'loot-core error: {e}')

# Search for OFX in actualbudget
url = 'https://api.github.com/repos/actualbudget/actual/git/trees/master?recursive=1'
try:
    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
    resp = urllib.request.urlopen(req, timeout=15)
    tree = json.loads(resp.read())
    for item in tree['tree']:
        path = item['path'].lower()
        if 'ofx' in path or 'csv' in path or 'import' in path or 'transaction' in path:
            if item['type'] == 'blob' and item['size'] < 50000:
                print(f'{item["path"]} ({item["size"]} bytes)')
except Exception as e:
    print(f'Actual Budget search error: {e}')


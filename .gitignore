__pycache__/
*.py[cod]
.venv/
.worktrees/
.cache/
node_modules/
target/
.origin/
sessions/active.json
.env
.env.*

# Agent runtime state, not repository content.
.opencode/

# Third-party inputs an experiment downloads and pins by hash. The record is
# sources.json, not the bytes: re-running `fetch_sources.py` reproduces them, and
# a tracked tarball would be vendored input that nothing verifies. The same
# clause covers E015's 905,521-name PyPI index, whose record is
# `raw/pypi-simple-meta.json`: url, status, bytes, sha256 and name count, and
# one request rebuilds the file.
EXPERIMENTS/*/sdists/
EXPERIMENTS/*/raw/pypi-simple-index.txt
# E039's capture is 334 MB of Hacker News comment rows across 21 files. The
# record is raw/MANIFEST.json - url, status, bytes, row count and a
# verify_manifest.py-computed sha256 per file - and re-running capture.py
# rebuilds it, by the same clause as the index above. arms.jsonl, the 1391
# need records every figure in results.json is derived from, is tracked.
EXPERIMENTS/039-need-statement-response/raw/shard-*.jsonl
EXPERIMENTS/039-need-statement-response/raw/log-*.jsonl
EXPERIMENTS/039-need-statement-response/raw/comments.jsonl
EXPERIMENTS/039-need-statement-response/raw/control.jsonl
# E049's raw lockfile snapshots (22 files, ~5.2 MB fetched from
# raw.githubusercontent.com at the commit SHAs results.json records).
# The record is raw-manifest.json - repo, path, commit sha, url,
# bytes and sha256 per file - and re-running harness.py part_a
# re-fetches the same commits, by the same clause as sdists/.
EXPERIMENTS/049-lockfile-closure/raw/
# E049's Part B snapshot: 16 wheels pip downloaded for a fixed
# requirements set. The record is results.json's part_b.artifacts
# (filename -> sha256), and re-running the harness's part_b_control
# re-downloads and re-hashes them, by the same clause as sdists/.
EXPERIMENTS/049-lockfile-closure/snapshot-b/
# E050's Part B control re-downloads the same requirements into its
# own snapshot-b/; same record, same clause.
EXPERIMENTS/050-registry-mechanisms/snapshot-b/
# stories.done is capture.py's resume ledger: 1276 story ids, one per line. It
# is machine state, not a document, and its count is in MANIFEST.json.
EXPERIMENTS/039-need-statement-response/raw/stories.done
# E065 synthetic corpus (generated by generate_corpus.py, record is manifest.json)
EXPERIMENTS/065-recurring-expense-detection/corpus/synthetic/
# E066's raw Berka tables (68 MB from a GitHub mirror of the PKDD'99 release).
# The record is raw/SOURCES.md - url, bytes and sha256 per file - and one curl
# command per file rebuilds them, by the same clause as sdists/.
EXPERIMENTS/066-berka-real-validation/raw/*.csv

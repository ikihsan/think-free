.origin/doctor.json

# OpCode workspace state
.opencode/

# Worktrees
.worktrees/

# Experiment bulk inputs
EXPERIMENTS/*/sdists/

# Python version records
tests/python-versions.json
tests/git-versions.json

# Task claims ledger
tasks/CLAIMS.jsonl

# Release manifest enforcement
RELEASE-MANIFEST.md
EXPERIMENTS/072-git-file-presence/repos/
# E085's per-distribution resolution cache: 762 files, 3.1 MB, regenerable
# from PyPI, and the repo already ignores E068's equivalent.
EXPERIMENTS/085-declared-not-provided/cache/
# E090's baseline cache: per-name PyPI lookups for the `pip install M`
# baseline, regenerable from PyPI by analyze.py, same clause.
EXPERIMENTS/090-reverse-index/baseline-cache/
.pyprovides-cache/

# E162's axe-core + jsdom install (31 MB, 1,862 files). Third-party code the
# experiment declares by version in EXPERIMENTS/162-*/package.json and
# package-lock.json, reproducible with `npm ci` in that directory — so the
# record is the lockfile, not the tree. Tracking the bytes would put 31 MB of
# vendored JavaScript into every commit that touches this experiment.
node_modules/
# A trailing slash does not match a symlink, and E163 reaches E162's install
# through one (`163-*/node_modules -> 162-*/node_modules`). Without this line
# git would track a single pointer whose target is already ignored, and the
# documentation gate would walk 1,862 vendored files through it.
node_modules

# E162's fetched corpus: 27 third-party pages (2.7 MB), re-fetchable with
# `node EXPERIMENTS/162-a11y-deterministic-repair/fetch.js`. The record is
# corpus-manifest.json - url, sha256 and bytes per page - plus the frame they
# belong to, and every number in RESULT.md is derived from those bytes. This is
# F004's rule (pin the inputs by hash, do not commit the tarballs) and the same
# clause E068's repos/ and E085's cache/ use. Tracking them would put 23 foreign
# documents, their sizes and their broken links under this repository's own
# documentation gate.
EXPERIMENTS/*/corpus/

# E202's fetched corpus: 85 third-party pages (5.8 MB), re-fetchable with
# `node EXPERIMENTS/202-line-anchor-rewrite/fetch.js` and `fetch2.js`. The record
# is corpus-manifest.json (url, sha256, bytes per page), and every number in
# RESULT.md is derived from those bytes. Same clause as E162's corpus above and
# F004's rule: pin the inputs by hash, do not commit the bodies.
EXPERIMENTS/202-line-anchor-rewrite/pages/

# `origin session finish` lock: a committed lock is a lock nothing holds
.finish.lock
.module-demand-cache/


data: [{"type":"repo","repositoryID":39092601,"repository":"github.com/ChuaCheowHuan/gym-continuousDoubleAuction","externalServiceType":"github","repoStars":154,"repoLastFetched":"2026-10-04T19:22:51.299283Z","description":"A custom MARL (multi-agent reinforcement learning) environment where multiple agents trade against one another (self-play) in a zero-sum continuous double auction. Ray [RLlib] is used for training.","topics":["multi-agent-reinforcement-learning","gym-environment","limit-order-book","high-frequency-trading","ray","rllib","market-microstructure","financial-engineering","self-play","double-auction","ppo","zero-sum-games","zero-sum","quantitative-finance","quantitative-trading","marl","n-player","lstm"]},{"type":"repo","repositoryID":39451571,"repository":"github.com/Dashticz/dashticz","externalServiceType":"github","repoStars":70,"repoLastFetched":"2026-10-05T03:03:21.69369Z","description":"Alternative dashboard for Domoticz"},{"type":"repo","repositoryID":64317632,"repository":"github.com/karanshukla/openresto","externalServiceType":"github","repoStars":95,"repoLastFetched":"2026-10-04T23:16:39.143251Z","description":"A simple, focused booking management system for restaurants, bars, cafes and more. Set up multiple restaurants per instance, and use your own email address to communicate with your customers. Customers get a simple, cross platform, mobile friendly UI to book tables securely. Self host and cloud friendly. ","topics":["booking","management","restaurants","docker","dotnet","efcore","expo","net","reactnative","booking-platform","restaurant-app","restaurant-management","restaurant-website","rms","booking-system"]},{"type":"repo","repositoryID":40621337,"repository":"github.com/lesterchan/wp-polls","externalServiceType":"github","repoStars":95,"repoLastFetched":"2026-10-04T20:41:04.055322Z","description":"Adds an AJAX poll system to your WordPress blog. You can also easily add a poll into your WordPress's blog post/page.","topics":["wp-polls","ajax-polling","polls","wordpress","wordpress-plugin","lesterchan"]},{"type":"repo","repositoryID":64287203,"repository":"github.com/bitwisecook/tcl-lsp","externalServiceType":"github","repoStars":70,"repoLastFetched":"2026-10-05T03:14:56.470352Z","description":"An LSP for Tcl 8.4-9.1, F5 iRules, F5 iApps and other Tcl dialects"},{"type":"repo","repositoryID":64103655,"repository":"github.com/aaddrick/claude-desktop-debian","externalServiceType":"github","repoStars":5431,"repoLastFetched":"2026-10-04T23:34:51.991005Z","description":"Claude Desktop for Linux"},{"type":"repo","repositoryID":64312460,"repository":"github.com/squid-protocol/gitgalaxy","externalServiceType":"github","repoStars":57,"repoLastFetched":"2026-10-05T03:03:54.606669Z","description":"Convert source code into a repository-scale structural model. Air gapped, zero dependencies, SARIF and SBOM outputs.","topics":["auditing","codebase-analysis","sbom","zero-trust","ai-security","appsec","cybersecurity","devsecops","incident-response","legacy-modernization","software-architecture","static-analysis","supply-chain-security","code-intelligence","graph-rag","knowledge-graph","sarif","sast"]},{"type":"repo","repositoryID":61568642,"repository":"github.com/MionKit/mion","externalServiceType":"github","repoStars":73,"repoLastFetched":"2026-10-05T02:20:22.885324Z","description":"Full Stack Apis at the speed of light 🚀","topics":["node","typescript","api","server","serverless","rpc"]},{"type":"repo","repositoryID":64299823,"repository":"github.com/efremidze/swift-architecture-skill","externalServiceType":"github","repoStars":71,"repoLastFetched":"2026-10-04T23:28:24.050091Z","description":"Agent Skill for Swift architecture design and implementation patterns.","topics":["agent","agent-skills","ios","swift","swiftui"]}]


data: [{"type":"repo","repositoryID":40018807,"repository":"github.com/abashev/vfs-s3","externalServiceType":"github","repoStars":106,"repoLastFetched":"2026-10-05T01:38:59.819827Z","description":"Amazon S3 driver for Apache commons-vfs (Virtual File System) project"},{"type":"repo","repositoryID":64292112,"repository":"github.com/open-agreements/open-agreements","externalServiceType":"github","repoStars":59,"repoLastFetched":"2026-10-05T00:18:49.801064Z","description":"Open, primary-source-backed U.S. legal content — practice guides, 50-state surveys, reviewer checklists, and standard agreement templates. Built for legal teams and the agents helping them.","topics":["anthropic","claude","contract-automation","docx","legal-tech","legal-templates","nda-template","open-source-legal","safe-template","gemini-cli-extension","mcp","mcp-server","legal-research","non-compete","privacy-law","us-law","legal-content","practice-guides","restrictive-covenants"]},{"type":"repo","repositoryID":64214010,"repository":"github.com/MaplePrivacyLabs/Maple","externalServiceType":"github","repoStars":98,"repoLastFetched":"2026-10-05T03:05:23.497697Z","description":"Maple - Private AI Chat"},{"type":"repo","repositoryID":64319325,"repository":"github.com/talirezun/the-curator","externalServiceType":"github","repoStars":98,"repoLastFetched":"2026-10-04T22:25:03.719251Z","description":"Your brain, then your team's brain, then your agents' brain. Drop in documents and it compounds them into an interlinked markdown wiki you own — readable in Obsidian, synced through your own private GitHub repo. Share it with a cohort. Coding agents resume from it across sessions, models and machines.","topics":["agent-memory","ai-agents","claude","gemini","knowledge-graph","knowledge-management","llm","local-first","markdown","mcp","model-context-protocol","nodejs","obsidian","openrouter","personal-knowledge-management","pkm","privacy","second-brain","self-hosted","wiki"]},{"type":"repo","repositoryID":643037
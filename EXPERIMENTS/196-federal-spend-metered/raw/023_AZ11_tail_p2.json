enerated_internal_id":"CONT_AWD_36C26320C0083_3600_-NONE-_-NONE-"},{"internal_id":308045545,"Award ID":"INDD0600080011","Award Amount":84425.0,"Description":"\"DEFFENSE READINESS AND TRAINING, COMPUTER NETWORK DEFENSE,  SPECIAL ACCESS PROGRAM INTEGRATED PROCESS TEAM AND SECURITY SUPPORT\"","generated_unique_award_id":null,"Awarding Agency":"Department of the Interior","awarding_agency_id":209,"agency_slug":"department-of-the-interior","generated_internal_id":"CONT_AWD_INDD0600080011_1406_IND06PC60093_1406"},{"internal_id":277749885,"Award ID":"140D0419F2814","Award Amount":85969.6,"Description":null,"generated_unique_award_id":null,"Awarding Agency":"Department of the Interior","awarding_agency_id":209,"agency_slug":"department-of-the-interior","generated_internal_id":"CONT_AWD_140D0419F2814_1406_IND03PC60076_1406"},{"internal_id":310476748,"Award ID":"N3239820P0230","Award Amount":86270.0,"Description":"EVALUATION OF NATURAL AND CHIMERIC PHAGE","generated_unique_award_id":null,"Awarding Agency":"Department of Defense","awarding_agency_id":1173,"agency_slug":"department-of-defense","generated_internal_id":"CONT_AWD_N3239820P0230_9700_-NONE-_-NONE-"},{"internal_id":291805680,"Award ID":"80GRC019F0005","Award Amount":87623.02,"Description":"IGF::OT::IGF THE NASA SPACE COMMUNICATIONS AND NAVIGATION (SCAN) PROGRAM IS DEVELOPING THE NEXT GENERATION OPEN ARCHITECTURE FOR CIVILIAN SPACE COMMUNICATIONS AND NAVIGATION. THE FUTURE ARCHITECTURE AND SYSTEM COMPONENTS MUST BE FLEXIBLE TO MEET DYNAMICALLY CHANGING NEEDS BETWEEN INVESTMENTS IN OPERATIONS (E.G., TO LOWER COST) AND DEVELOPMENT (.E., TO INFUSE NEW AND EMERGING TECHNOLOGIES). THE RESULTANT ARCHITECTURE MUST BE AFFORDABLE AS WELL AS SUSTAINABLE WITHIN A FLAT OR DECREASING BUDGET ENVIRONMENT. SCAN'S ARCHITECTURE-THE ORGANIZATION OF ITS SYSTEMS AND THEIR RELATIONSHIPS TO ONE ANOTHER-IS IN THE MIDST OF AN EXCITING TRANSFORMATION THAT WILL ENABLE ITS SYSTEMS TO MEET THE DATA-INTENSIVE REQUIREMENTS OF THE EVER-INCREASING POPULATION OF THE UNITED STATES' SPACE-BOUND MISSIONS. LEVERAGING NASA'S PRIOR INVESTMENTS IN SCAN'S INFRASTRUCTURE, THE SERVICES PROVIDED BY THE SCAN PROGRAM ARE EVOLVING TO BECOME MORE FLEXIBLE AND EASIER TO SCALE TO MEET MISSION USER DEMAND. THE ARCHITECTURE IS DESIGNED TO ACCEPT THE RAPID INFUSION OF NEW TECHNOLOGIES AND TO CAPITALIZE ON THE EFFICIENCY AND CAPABILITY OF THE UNITED STATES'COMMERCIAL SATELLITE COMMUNICATIONS (COMSATCOM) INDUSTRY TO PROVIDE THE OPTIMAL SERVICES TO NASA MISSIONS. SCAN MUST NOW BEGIN TO DEVELOP THE IMPLEMENTATION STRATEGY TO BEGIN ACHIEVING INSTANTIATION OF THE ARCHITECTURAL VISION. THIS TASK REQUIRES THE CONTRACTOR TO HAVE EXTENSIVE PROGRAMMATIC AND STRAGIC EXPERIENCE INVOLVING NASA'S SPACE NETWORK.","generated_unique_award_id":null,"Awarding Agency":"National Aeronautics and Space Administration","awarding_agency_id":862,"agency_slug":"national-aeronautics-and-space-administration","generated_internal_id":"CONT_AWD_80GRC019F0005_8000_NNC14CA02C_8000"},{"internal_id":308019152,"Award ID":"IND06PD76185","Award Amount":88062.66,"Description":"R&D","generated_unique_award_id":null,"Awarding Agency":"Department of the Interior","awarding_agency_id":209,"agency_slug":"department-of-the-interior","generated_internal_id":"CONT_AWD_IND06PD76185_1406_IND04PC60078_1406"},{"internal_id":272618936,"Award ID":"00063200207DNBCHC020081","Award Amount":88574.73,"Description":null,"generated_unique_award_id":null,"Awarding Agency":"Department of the Interior","awarding_agency_id":209,"agency_slug":"department-of-the-interior","generated_internal_id":"CONT_AWD_00063200207DNBCHC020081_1406_-NONE-_-NONE-"},{"internal_id":298260509,"Award ID":"FA520919PA099","Award Amount":90567.69,"Description":"ARMY RESEARCH AND DEVELOPMENT - CONCEPTUAL DESIGN OF VTOL PLATFORMS FOR NEXT-GENERATION ROTOCRAFT IN ACCORDANCE WITH STATEMENT OF WORK PERFORMANCE","generated_unique_award_id":null,"Awarding Agency":"Department of Defense","awarding_agency_id":1173,"agency_slug":
NOW IN ADVANCE WHICH CITIES WILL FOLLOW. TO ENSURE EMBEDDED ELEMENTS REMAIN CLOSE TO THE TEAM, DS CONTRACTS WITH USSF TO PROVIDE THE SAME LODGING FOR THE AGENTS AS THE USWNT AND FRIENDS AND FAMILY PROGRAM. AT THE CONCLUSION OF THE TOURNAMENT USSF WILL SUBMIT AN INVOICE TO THE DEPARTMENT FOR THE COSTS INCURRED FOR THE DS AGENTS. A COST ESTIMATE IS ATTACHED.","generated_unique_award_id":null,"Awarding Agency":"Department of State","awarding_agency_id":315,"agency_slug":"department-of-state","generated_internal_id":"CONT_AWD_19AQMM19P0874_1900_-NONE-_-NONE-"},{"internal_id":278725804,"Award ID":"19AQMM19P2413","Award Amount":0.0,"Description":"GOLD SUPPORT KIT FOR THREE YEARS MAINTENANCE OF DSX5000 AND DSX W/QUAD OLTS INSP.","generated_unique_award_id":null,"Awarding Agency":"Department of State","awarding_agency_id":315,"agency_slug":"department-of-state","generated_internal_id":"CONT_AWD_19AQMM19P2413_1900_-NONE-_-NONE-"},{"internal_id":278726711,"Award ID":"19AQMM20F0175","Award Amount":0.0,"Description":"STAFFING SUPPORT IN THE WASHINGTON DC METRO AREA","generated_unique_award_id":null,"Awarding Agency":"Department of State","awarding_agency_id":315,"agency_slug":"department-of-state","generated_internal_id":"CONT_AWD_19AQMM20F0175_1900_19AQMM18D0105_1900"},{"internal_id":278726786,"Award ID":"19AQMM20F0262","Award Amount":0.0,"Description":"ADVISORY AND ASSISTANCE SUPPORT SERVICES IN THE WASHINGTON DC METRO AREA","generated_unique_award_id":null,"Awarding Agency":"Department of State","awarding_agency_id":315,"agency_slug":"department-of-state","generated_internal_id":"CONT_AWD_19AQMM20F0262_1900_19AQMM18D0105_1900"},{"internal_id":278727376,"Award ID":"19AQMM20F0994","Award Amount":0.0,"Description":"IDIQ TASK ORDER 011 - WSTS FIELD  BFFOC TRAINING (FASTC)","generated_unique_award_id":null,"Awarding Agency":"Department of State","awarding_agency_id":315,"agency_slug":"department-of-state","generated_internal_id":"CONT_AWD_19AQMM20F0994_1900_19AQMM18D0148_1900"},{
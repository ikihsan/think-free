TO EXPLORE THE FEASIBILITY AND EFFECTIVENESS OF ALTERNATIVE METHODS FOR IMPLEMENTING CUSTOMER CALLBACK WITHOUT ANY DATA FEEDS BETWEEN IRS AND VZ.  THE CONTRACTOR SHALL PERFORM IN ACCORDANCE WITH THE INCORPORATED VERIZON QUOTE AND PROPOSAL PROVIDED VIA EMAIL ON 9/27/2018.  A NOTICE TO PROCEED WAS ISSUED ON 10/05/2018  PERIOD OF PERFORMANCE: 10/05/2018 - 09/20/2019  ASRN 1: TIRNO10S00001-WRO44-CUSTOMER CALLBACK/PILOT PHASE II","generated_unique_award_id":null,"Awarding Agency":"Department of the Treasury","awarding_agency_id":456,"agency_slug":"department-of-the-treasury","generated_internal_id":"CONT_AWD_2032H519F00114_2050_TIRNO10S00001_2050"},{"internal_id":292212128,"Award ID":"95315818F0014","Award Amount":157014.16,"Description":"IGF::OT::IGF CELL PHONE AND BROADBAND SERVICE","generated_unique_award_id":null,"Awarding Agency":"Department of the Treasury","awarding_agency_id":456,"agency_slug":"department-of-the-treasury","generated_internal_id":"CONT_AWD_95315818F0014_9565_GS00Q13NSA3003_4732"},{"internal_id":279037394,"Award ID":"20341518F00018","Award Amount":160586.89,"Description":"WIRELESS SERVICE","generated_unique_award_id":null,"Awarding Agency":"Department of the Treasury","awarding_agency_id":456,"agency_slug":"department-of-the-treasury","generated_internal_id":"CONT_AWD_20341518F00018_2036_TIRNO16Z00009_2050"},{"internal_id":279036175,"Award ID":"20341220F00012","Award Amount":169250.04,"Description":"IT:  THIS PURCHASE REQUEST IS TO ESTABLISH A MAINTENANCE VENDOR AVAYA COMMUNICATION MANAGER.  AVAYA AURA MESSAGING, CMS SYSTEM MANAGER, SESSION MANAGER, ASBCE DEVICE IN VIENNA VA AND WASHINGTON, DC.","generated_unique_award_id":null,"Awarding Agency":"Department of the Treasury","awarding_agency_id":456,"agency_slug":"department-of-the-treasury","generated_internal_id":"CONT_AWD_20341220F00012_2036_NNG15SC84B_8000"},{"internal_id":279025098,"Award ID":"2032H519F00519","Award Amount":169346.4,"Description":"NEW PURCHASE ORDER NUMBER 2000103186 WORK REQUE
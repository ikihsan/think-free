data: [{"type":"repo","repositoryID":64255473,"repository":"github.com/zeybek/camouflage.nvim","externalServiceType":"github","repoStars":62,"repoLastFetched":"2026-10-05T01:19:25.235957Z","description":"Hide secrets like API keys, passwords and tokens in Neovim while screen sharing or streaming. Masks .env, JSON, YAML, TOML, XML, .http, Terraform/HCL and Dockerfiles with extmarks, without changing the file. Presentation mode, screen shield, picker and terminal masking.","topics":["dotenv","lua","neovim","neovim-plugin","nvim","privacy","screen-sharing","secrets","security","devops","hcl","infrastructure-as-code","terraform","api-keys","conceal","environment-variables","luarocks","passwords","streaming"]},{"type":"repo","repositoryID":36381406,"repository":"github.com/hslua/hslua","externalServiceType":"github","repoStars":140,"repoLastFetched":"2026-10-04T20:09:07.542141Z","description":"Haskell bindings to Lua, an embeddable scripting language.","topics":["haskell","lua","lua-bindings","hslua"]},{"type":"repo","repositoryID":64335884,"repository":"github.com/GilbN/geometrikks","externalServiceType":"github","repoStars":140,"repoLastFetched":"2026-10-05T02:39:16.613352Z","description":"GeoMetrikks is a real-time nginx/traefik/caddy access log ingestion and geo-location tracking service built with Litestar. It parses access logs, performs GeoIP lookups, and stores geo-events and access logs in PostgreSQL with TimeScaleDB/PostGIS extensions. It can also integrate with CrowdSec.","topics":["geoip2","geolocation-metrics","gis","litestar","log-metrics","maxmind-geoip","nginx","postgis","python","react","timescaledb","vite","maplibre-gl","crowdsec","traefik","agent-mode","multi-host","multi-source","caddy"]},{"type":"repo","repositoryID":64342341,"repository":"github.com/RockeyRoc/DeepProf","externalServiceType":"github","repoStars":80,"repoLastFetched":"2026-10-05T01:24:02.780827Z","description":"DeepProf——面向高等教育的个性化伴学智能体，基于自研 Agent Runtime 与教学策略图协同的课程级伴学智能体：答案可溯源、引导可分级
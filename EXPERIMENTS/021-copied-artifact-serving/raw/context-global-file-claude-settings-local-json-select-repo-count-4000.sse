nife4j","java","mybatis","springcloud","elasticsearch","kafka","redis","dubbo","springboot","zookeeper","rocketmq","eureka","nacos"]},{"type":"repo","repositoryID":64165525,"repository":"github.com/JasonJarvan/Zhihu-Collections-MCP","externalServiceType":"github","repoStars":180,"repoLastFetched":"2026-10-04T23:04:51.414587Z","description":"将知乎收藏夹（公开和私密）批量导出为 Markdown 格式文件. 支持配置收藏夹列表并批量下载, 支持基于URL自动去重, 支持下载专栏和图片, 支持自定义保存路径, 支持调试和错误日志. **同时提供 MCP Server**，可被 AI Agent (如 Claude Code) 直接调用，为大模型提供保存知乎收藏夹的能力。"},{"type":"repo","repositoryID":40074047,"repository":"github.com/Darkside138/DiscordSoundboard","externalServiceType":"github","repoStars":151,"repoLastFetched":"2026-10-05T02:06:29.895771Z","description":"Java Soundboard for Discord","topics":["discord","soundboard","jar","spring-boot","play-sounds","bot"]},{"type":"repo","repositoryID":64099566,"repository":"github.com/shader-slang/slang-rhi","externalServiceType":"github","repoStars":212,"repoLastFetched":"2026-10-04T23:12:55.739374Z","description":"Slang Render Hardware Interface"},{"type":"repo","repositoryID":64294844,"repository":"github.com/TrueCrimeDev/ClautoHotkey","externalServiceType":"github","repoStars":51,"repoLastFetched":"2026-10-04T23:52:57.013477Z","description":"In-depth AHK v2 coding harness build with all the tools to create advanced AHK v2 projects."},{"type":"repo","repositoryID":64093130,"repository":"github.com/LegendApp/legend-list","externalServiceType":"github","repoStars":3418,"repoLastFetched":"2026-10-04T22:41:31.232747Z","description":"A high-performance list component for React Native and React"},{"type":"repo","repositoryID":64212985,"repository":"github.com/SimonSchubert/Kai","externalServiceType":"github","repoStars":1271,"repoLastFetched":"2026-10-05T01:35:44.34465Z","description":"OpenClaw alternative in your pocket","topics":["ai","kotlin-multiplatform","chatbot","jetpack-compose","ai-assistant","android","ios","openai-compatible","openclaw","gemma4","litert"]},{"type":"repo"
data: [{"type":"repo","repositoryID":64167227,"repository":"github.com/tableau/tableau-mcp","externalServiceType":"github","repoStars":347,"repoLastFetched":"2026-10-05T03:11:18.020035Z","description":"Tableau's official MCP Server. Helping agents see and understand data.","topics":["mcp","mcp-server","modelcontextprotocol","tableau"]},{"type":"repo","repositoryID":40065004,"repository":"github.com/shopsys/shopsys","externalServiceType":"github","repoStars":350,"repoLastFetched":"2026-10-04T23:23:18.241901Z","description":"Main repository for maintaining Shopsys Platform packages. Open for ISSUES and PULL REQUESTS. ","topics":["e-commerce","ecommerce-framework","ecommerce-platform","shopsys-framework","shopsys-platform"]},{"type":"repo","repositoryID":64254209,"repository":"github.com/Noizefield/audio-plugin-coder","externalServiceType":"github","repoStars":327,"repoLastFetched":"2026-10-05T01:34:12.867395Z","description":"Audio Plugin Coder (APC) is a groundbreaking, open-source framework that enables musicians, producers, sound designers, and developers to create professional VST3/AU audio plugins using natural language and AI assistance. Built on JUCE 9 and powered by a revolutionary 5-phase workflow system."},{"type":"repo","repositoryID":64245214,"repository":"github.com/ShareX/XerahS","externalServiceType":"github","repoStars":327,"repoLastFetched":"2026-10-05T01:17:55.512717Z","description":"XerahS is a cross platform reimagining of the ShareX user interface built with Avalonia. It targets modern UX modular architecture and long term maintainability while preserving core workflows speed and reliability. It provides a foundation for future desktop experiences on Windows, macOS, and Linux with consistent accessible design.","topics":["avalonia","sharex","xerahs"]},{"type":"repo","repositoryID":64320256,"repository":"github.com/responsibleai/ASSERT","externalServiceType":"github","repoStars":323,"repoLastFetched":"2026-10-05T02:01:32.443541Z","description":"Requ
import os
import sys
import json


def load(path):
    with open(path) as fh:
        return fh.read()


def save(path, data):
    with open(path, "w") as fh:
        fh.write(data)


def main():
    if len(sys.argv) < 2:
        print("usage: app.py PATH")
        return 1
    print(load(sys.argv[1]))
    return 0


if __name__ == "__main__":
    sys.exit(main())

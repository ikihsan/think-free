</THEAD>
<TBODY>
<TR>
<TD class="left border-right-single">Up to 20 tonnes</TD>
<TD class="left">25 percent in excess.</TD>
</TR>
<TR>
<TD class="left border-right-single">20 to 50 tonnes</TD>
<TD class="left">5 tonnes in excess.</TD>
</TR>
<TR>
<TD class="left border-bottom-single border-right-single">Over 50 tonnes</TD>
<TD class="left border-bottom-single">10 percent in excess.</TD>
</TR>
</TBODY>

<TH class="center border-bottom-single">Applicable percentage</TH>
</TR>
</THEAD>
<TBODY>
<TR>
<TD class="left border-right-single">February 1</TD>
<TD class="right border-right-single">50</TD>
<TD class="right border-right-single">50</TD>
<TD class="left">50/1,000 = 5 percent.</TD>
</TR>
<TR>
<TD class="left border-right-single">May 15</TD>
<TD class="right border-right-single">50</TD>
<TD class="right border-right-single">100</TD>
<TD class="left">100/1,000 = 10 percent.</TD>
</TR>

</TR>
<TR>
<TD class="left">Amosite</TD>
<TD class="left">(Mg,Fe)<sub>7</sub> Si<sub>8</sub> O<sub>22</sub> (OH)<sub>2</sub>
</TD>
</TR>
<TR>
<TD class="left">Tremolite-actinolite</TD>
<TD class="left">Ca<sub>2</sub> (Mg,Fe)<sub>5</sub> Si<sub>8</sub> O<sub>22</sub> (OH)<sub>2</sub>
</TD>
</TR>

"""
E093 — Discrimination test prototype for view-count principle classification.

Tests whether an improved discrimination instrument can pass G2 (≥0.85 accuracy)
on hand-classified labels "known by construction" from the E083 aviation
maintenance experiment.

The current instrument (Bing search + 19-word solution keyword list) fails:
  - 19/30 automated "served" vs 0/30 hand "served"
  - G2 accuracy 0.70, needs ≥0.85

This prototype tests improved classification signals against the ground truth
from E083/E088.
"""

import json
import os
import re
import sys

# Absolute paths
EXP = "/home/ubuntu/think-free/EXPERIMENTS/083-aviation-maintenance-fault-codes"
TREATMENT_RESULTS = os.path.join(EXP, "raw", "treatment-results.jsonl")
RESULTS_JSON = os.path.join(EXP, "results.json")


def load_treatment_results():
    """Load treatment arm search results (20 rows, statement_ids 0-19)."""
    results = []
    with open(TREATMENT_RESULTS, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line:
                results.append(json.loads(line))
    return results


# ============================================================
# Hand classification rubric (identical to e090-hand-classify.py)
# ============================================================

SOLUTION_KEYWORDS = [
    'how to', 'tutorial', 'guide', 'solution', 'fix', 'repair',
    'tool', 'software', 'app', 'download', 'install',
    'step by step', 'method', 'procedure', 'resolution',
    'fix for', 'fixes', 'troubleshooting',
]

INFO_KEYWORDS = [
    'definition', 'what is', 'overview', 'introduction',
    'summary', 'characteristics', 'fault code',
    'meaning', 'indicates', 'refers to',
]


def classify_hand(r):
    """Classify a row using the e090 hand-classification rubric.
    
    served:           working solution, direct link to tool/manual, or
                    step-by-step resolution guide for the specific fault code
    partially_served: relevant info (error code definition, manufacturer notes)
                    but no complete resolution guide
    unserved:         no relevant results, or only irrelevant results
    """
    all_text = ' '.join(r['titles'] + r['snippets']).lower()
    has_solution = any(kw in all_text for kw in SOLUTION_KEYWORDS)
    has_info = any(kw in all_text for kw in INFO_KEYWORDS)
    titles = r['titles']
    has_tool_title = any(
        t and any(kw in t.lower() for kw in ['tool', 'software', 'app', 'guide', 'tutorial', 'manual'])
        for t in titles
    )
    if has_solution or has_tool_title:
        return 'served'
    elif has_info:
        return 'partially_served'
    else:
        return 'unserved'


# ============================================================
# Improved classification instruments
# ============================================================

def classify_v1(r):
    """Version 1: subject mention + guide structure.
    
    Signals:
    - subject_mentioned: does the retrieved text mention the specific
      query subject (fault code / error terms)?
    - has_guide: does the content have resolution guide markers?
    """
    all_text = ' '.join(r['titles'] + r['snippets']).lower()
    
    # Extract subject terms from query (stopword-filtered)
    stopwords = {
        'the', 'a', 'an', 'and', 'or', 'but', 'if', 'because', 'as', 'until',
        'while', 'of', 'at', 'by', 'for', 'with', 'about', 'against', 'between',
        'into', 'through', 'during', 'before', 'after', 'above', 'below', 'to',
        'from', 'up', 'down', 'in', 'out', 'on', 'off', 'over', 'under', 'again',
        'further', 'then', 'once', 'here', 'there', 'when', 'where', 'why', 'how',
        'what', 'which', 'who', 'whom', 'this', 'that', 'these', 'those', 'i', 'me',
        'my', 'myself', 'we', 'our', 'ours', 'ourselves', 'you', 'your', 'yours',
        'yourself', 'he', 'him', 'his', 'himself', 'she', 'her', 'hers', 'herself',
        'it', 'its', 'itself', 'they', 'them', 'their', 'theirs', 'themselves',
        'do', 'does', 'did', 'doing', 'a', 'an'
    }
    terms = re.findall(r'[a-z0-9]+', r['query'].lower())
    subject_terms = [t for t in terms if t not in stopwords and not t.isdigit()]
    
    if not subject_terms:
        return classify_hand(r)  # fallback
    
    # Check if subject terms appear in retrieved text
    blob = all_text
    subject_mentioned = any(term in blob for term in subject_terms)
    
    has_solution = any(kw in all_text for kw in SOLUTION_KEYWORDS)
    has_info = any(kw in all_text for kw in INFO_KEYWORDS)
    
    # Classification: need BOTH subject mention AND solution guide
    # (strict signal to reduce false positives from generic keywords)
    if subject_mentioned and has_solution:
        return 'served'
    elif subject_mentioned and has_info and not has_solution:
        return 'partially_served'
    elif has_solution and not subject_mentioned:
        # Generic solution keywords, no specific subject - likely false positive
        return 'unserved'
    elif has_info and not subject_mentioned:
        # Only definition/info, no specific subject - partially_served
        return 'partially_served'
    elif not has_solution and not has_info:
        return 'unserved'
    else:
        return 'unserved'


def classify_v2(r):
    """Version 2: stricter - requires subject mention + step-by-step patterns.
    
    Adds check for step-by-step execution patterns (click, press, select, etc.)
    and part-number references to further reduce false positives.
    """
    all_text = ' '.join(r['titles'] + r['snippets']).lower()
    
    # Extract subject terms
    stopwords = {
        'the', 'a', 'an', 'and', 'or', 'but', 'if', 'because', 'as', 'until',
        'while', 'of', 'at', 'by', 'for', 'with', 'about', 'against', 'between',
        'into', 'through', 'during', 'before', 'after', 'above', 'below', 'to',
        'from', 'up', 'down', 'in', 'out', 'on', 'off', 'over', 'under', 'again',
        'further', 'then', 'once', 'here', 'there', 'when', 'where', 'why', 'how',
        'what', 'which', 'who', 'whom', 'this', 'that', 'these', 'those', 'i', 'me',
        'my', 'myself', 'we', 'our', 'ours', 'ourselves', 'you', 'your', 'yours',
        'yourself', 'he', 'him', 'his', 'himself', 'she', 'her', 'hers', 'herself',
        'it', 'its', 'itself', 'they', 'them', 'their', 'theirs', 'themselves',
        'do', 'does', 'did', 'doing', 'a', 'an'
    }
    terms = re.findall(r'[a-z0-9]+', r['query'].lower())
    subject_terms = [t for t in terms if t not in stopwords and not t.isdigit()]
    
    if not subject_terms:
        return classify_hand(r)
    
    blob = all_text
    subject_mentioned = any(term in blob for term in subject_terms)
    
    has_solution = any(kw in all_text for kw in SOLUTION_KEYWORDS)
    has_info = any(kw in all_text for kw in INFO_KEYWORDS)
    
    # Check for step-by-step patterns
    step_kws = ['step by step', 'first', 'second', 'then', 'finally',
                'click', 'press', 'select', 'navigate', 'run', 'execute']
    has_step_by_step = any(kw in all_text for kw in step_kws)
    
    # Check for part/component references
    part_kws = ['part number', 'pn ', 'p/n', 'component', 'module', 'assembly']
    has_part_info = any(kw in all_text for kw in part_kws)
    
    # V2 strict: subject mentioned + solution + (step-by-step OR part info)
    if subject_mentioned and has_solution and (has_step_by_step or has_part_info):
        return 'served'
    elif subject_mentioned and has_info and not has_solution:
        return 'partially_served'
    elif subject_mentioned and has_solution and not has_step_by_step and not has_part_info:
        # Subject mentioned with generic guide markers only
        return 'partially_served'  # lean away from served to avoid FPs
    elif not subject_mentioned and has_solution:
        return 'unserved'
    elif not subject_mentioned and has_info:
        return 'partially_served'
    else:
        return 'unserved'


